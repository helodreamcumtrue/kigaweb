# ==============================================================================
# KIGA ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` for local development or configure these variables
# in the Vercel Project Settings > Environment Variables.
# ==============================================================================

# Transactional Email Provider (Resend)
# Obtain a free API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The destination business email address where customer inquiries are delivered
# Example: team@kiga.io, arnav@kiga.io, or your personal email for testing
CONTACT_TO_EMAIL=hello@kiga.io

# Verified sender email address
# If using Resend's free tier without a custom domain, you can use: onboarding@resend.dev
# Once your domain (e.g., kiga.io) is verified in Resend, use: contact@kiga.io
CONTACT_FROM_EMAIL=onboarding@resend.dev
